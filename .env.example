# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key both work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Google Cloud Console → APIs & Services → Credentials → API key
# (restrict it to the "Cloud Vision API"). Server-side only — never prefix with NEXT_PUBLIC_.
GOOGLE_VISION_API_KEY=your-google-vision-api-key
