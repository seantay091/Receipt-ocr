# Copy to .env and fill in as needed. .env is git-ignored.

# Optional: enables the "Claude" OCR option. Leave blank to use open-source OCR only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Where the database and uploaded files live (default: ./data in the repo)
# DATA_DIR=./data

# Server bind address / port
# HOST=0.0.0.0
# PORT=8000

# MAX_UPLOAD_MB=20
